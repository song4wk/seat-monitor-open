name: Course Seat Watch

on:
  push:
    paths:
      - '.github/workflows/watch.yml'
  schedule:
    # 每15分钟触发一次，避免单个job过长导致session不稳定
    - cron: "*/15 * * * *"
  workflow_dispatch:

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 25   # 原来是20，现在单次流程本身就要跑16分钟+前置的pip install等，20分钟可能不够，留出余量改成25

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install requests beautifulsoup4

      - name: Run seat monitor
        run: python -u seat_watch.py
        env:
          PYTHONUNBUFFERED: "1"
          BASE: ${{ secrets.BASE }}
          USER_ID: ${{ secrets.USER_ID }}
          PASSWORD: ${{ secrets.PASSWORD }}
          BARK_KEY_1: ${{ secrets.BARK_KEY_1 }}
          BARK_KEY_2: ${{ secrets.BARK_KEY_2 }}
